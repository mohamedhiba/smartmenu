# Copy to .env.local and fill in. .env.local is gitignored - never commit a key.
#
# Gemini is our primary provider. Get a free key at https://aistudio.google.com/apikey
# The free tier rate-limits per key, so USE YOUR OWN KEY while developing -
# three of us on one key will throttle each other.
GEMINI_API_KEY=

# Optional extra keys. We rotate across all of them and skip any that is
# rate-limited, which is how we survive the free tier during the demo.
# A single var may also hold a comma-separated list.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Fallback, used only when Gemini errors or rate-limits (issue #19).
OPENAI_API_KEY=

# Set to 1 to force /api/analyze to return lib/fixtures.ts without calling any
# model. Also available per-request as /api/analyze?demo=1
DEMO_MODE=0
